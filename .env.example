# ============================================================
# Environment Variables Example Template
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# Firebase (client-side configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Metron Proxy URL (optional, for deployed standalone APK)
# EXPO_PUBLIC_METRON_PROXY_URL=https://your-proxy-domain.com/api

# Metron API — SERVER-SIDE ONLY for scripts/cors-proxy.js
# Do NOT prefix with EXPO_PUBLIC_
METRON_USER=your_metron_username
METRON_PASS=your_metron_password

